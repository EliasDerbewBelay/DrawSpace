# ─── Required ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/drawspace
CLERK_SECRET_KEY=sk_live_...
CLIENT_URL=https://your-frontend.vercel.app

# ─── Render sets PORT automatically ───────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# ─── Redis (Upstash recommended for production) ─────────────
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379

# ─── Optional: extra CORS origins (comma-separated) ─────────
# ALLOWED_ORIGINS=https://preview.vercel.app,https://www.yourdomain.com
