# ─── Required ───────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string
#
# Option A (simple): Direct connection for app + migrations
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#
# Option B (Render/production): Session pooler for app, direct for migrations
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#
# Notes:
# - URL-encode special characters in passwords (@ → %40, etc.)
# - Unpause the Supabase project if connections fail (free tier pauses after inactivity)
# - Do NOT use Transaction pooler (port 6543) with Prisma migrations

CLERK_SECRET_KEY=sk_live_...
# Comma-separated frontend origins (no trailing slashes)
CLIENT_URL=http://localhost:3000,https://drawspace-kbzi.onrender.com

# ─── Server ─────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# ─── Redis (Upstash) ────────────────────────────────────────
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379

# ─── Optional ───────────────────────────────────────────────
# DATABASE_POOL_MAX=10
# Extra CORS origins (optional; same comma-separated format as CLIENT_URL)
# ALLOWED_ORIGINS=https://preview.vercel.app
